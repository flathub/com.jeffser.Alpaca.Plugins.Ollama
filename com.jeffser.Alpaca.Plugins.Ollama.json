{
  "id": "com.jeffser.Alpaca.Plugins.Ollama",
  "runtime": "com.jeffser.Alpaca",
  "runtime-version": "stable",
  "sdk": "org.gnome.Sdk//49",
  "build-extension": true,
  "cleanup": ["*.a", "*.la"],
  "modules": [
    {
      "name": "ollama",
      "buildsystem": "simple",
      "build-commands": ["cp -rf --remove-destination ./* ${FLATPAK_DEST}/"],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/ollama/ollama/releases/download/v0.15.1/ollama-linux-amd64.tar.zst",
          "sha256": "cc845709a3153c9661f0a5dea8487acd4c058bc46ebeeb7c8129b54d29a3ac3e",
          "strip-components": 0,
          "only-arches": ["x86_64"]
        },
        {
          "type": "archive",
          "url": "https://github.com/ollama/ollama/releases/download/v0.15.1/ollama-linux-arm64.tar.zst",
          "sha256": "c55a22ff658025b98844860abae91b1245fd80c5983c0e382597311ecf2d5a89",
          "strip-components": 0,
          "only-arches": ["aarch64"]
        }
      ]
    },
    {
      "name": "metainfo",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm0644 com.jeffser.Alpaca.Plugins.Ollama.metainfo.xml ${FLATPAK_DEST}/share/metainfo/${FLATPAK_ID}.metainfo.xml"
      ],
      "sources": [
        {
          "type": "file",
          "path": "com.jeffser.Alpaca.Plugins.Ollama.metainfo.xml"
        }
      ]
    }
  ]
}
